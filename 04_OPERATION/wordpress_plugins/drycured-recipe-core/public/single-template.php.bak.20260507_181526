<?php
if (!defined('ABSPATH')) exit;
add_filter('the_content','drycured_render_public_recipe_content',20);
function drycured_render_public_recipe_content($content){
    if(!is_singular('dry_recipe')||!in_the_loop()||!is_main_query()) return $content;
    $pid=get_the_ID(); $data=json_decode(get_post_meta($pid,'_dry_recipe_data',true),true); if(!is_array($data)) $data=[];
    $summary=['Osnovna masa'=>!empty($data['batch_weight_kg'])?$data['batch_weight_kg'].' kg':'','Regija'=>$data['region']??drycured_first_term($pid,'dry_region'),'Vrsta'=>$data['category']??drycured_first_term($pid,'dry_product_category'),'Meso'=>implode(', ',$data['meat_types']??[]),'Kalkulator'=>get_post_meta($pid,'_dry_calculator_ready',true)?'dostupan':'u pripremi'];
    ob_start(); ?>
<article class="drycured-public-recipe">
<header class="drycured-recipe-hero"><div class="drycured-kicker">Recept</div><h1><?php echo esc_html(get_the_title($pid)); ?></h1><?php if(!empty($data['short_description'])) echo '<p class="drycured-lead">'.esc_html($data['short_description']).'</p>'; ?><div class="drycured-chip-row"><?php foreach($summary as $v) if($v) echo '<span>'.esc_html($v).'</span>'; ?></div><?php if(get_post_meta($pid,'_dry_calculator_ready',true)) echo '<a class="drycured-primary-action" href="'.esc_url(home_url('/kalkulator/?recipe_id='.rawurlencode(get_post_meta($pid,'_dry_recipe_id',true)))).'">Izračunaj količine</a>'; ?></header>
<div class="drycured-recipe-shell"><aside class="drycured-recipe-side"><h2>Brzi pregled</h2><ul><?php foreach($summary as $k=>$v) if($v) echo '<li><strong>'.esc_html($k).'</strong><br>'.esc_html($v).'</li>'; ?></ul></aside><main class="drycured-recipe-main"><?php drycured_rows_section('Mesni sastav',$data['meat_composition']??[]); drycured_rows_section('Sastojci i začini',$data['ingredients']??[]); drycured_steps_section('Priprema',$data['procedure_steps']??[]); drycured_rows_section('Najčešće greške i rješenja',$data['problems']??[]); if(empty($data['meat_composition'])&&empty($data['ingredients'])&&empty($data['procedure_steps'])) echo '<section class="drycured-panel"><h2>Recept</h2>'.wpautop(esc_html(wp_strip_all_tags($content))).'</section>'; ?></main></div></article>
<?php return ob_get_clean(); }
function drycured_rows_section($title,$rows){ if(empty($rows)||!is_array($rows)) return; echo '<section class="drycured-panel"><h2>'.esc_html($title).'</h2><table class="drycured-modern-table">'; $heads=array_keys($rows[0]); echo '<thead><tr>'; foreach($heads as $h) echo '<th>'.esc_html(drycured_label($h)).'</th>'; echo '</tr></thead><tbody>'; foreach($rows as $r){ echo '<tr>'; foreach($heads as $h) echo '<td>'.esc_html((string)($r[$h]??'')).'</td>'; echo '</tr>'; } echo '</tbody></table></section>'; }
function drycured_steps_section($title,$steps){ if(empty($steps)) return; echo '<section class="drycured-panel"><h2>'.esc_html($title).'</h2><ol class="drycured-steps">'; foreach($steps as $s) echo '<li>'.esc_html($s).'</li>'; echo '</ol></section>'; }
