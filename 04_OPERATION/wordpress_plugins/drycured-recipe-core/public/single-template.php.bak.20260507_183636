<?php
if (!defined('ABSPATH')) exit;

add_filter('the_content', 'drycured_render_public_recipe_content', 20);

function drycured_render_public_recipe_content($content) {
    if (!is_singular('dry_recipe') || !in_the_loop() || !is_main_query()) {
        return $content;
    }

    $post_id = get_the_ID();
    $data_raw = get_post_meta($post_id, '_dry_recipe_data', true);
    $data = $data_raw ? json_decode($data_raw, true) : [];

    if (!is_array($data)) {
        $data = [];
    }

    $public = (!empty($data['public_recipe']) && is_array($data['public_recipe']))
        ? $data['public_recipe']
        : [];

    $title = get_the_title($post_id);

    $intro = $public['intro'] ?? ($data['short_description'] ?? get_the_excerpt($post_id));

    $region = $data['region'] ?? drycured_recipe_term_name_v4($post_id, 'dry_region');
    $microregion = $data['microregion'] ?? drycured_recipe_term_name_v4($post_id, 'dry_microregion');
    $category = $data['category'] ?? drycured_recipe_term_name_v4($post_id, 'dry_product_category');
    $product_type = $data['product_type'] ?? drycured_recipe_term_name_v4($post_id, 'dry_product_type');

    $meat_types = !empty($data['meat_types']) && is_array($data['meat_types'])
        ? implode(', ', $data['meat_types'])
        : drycured_recipe_terms_join_v4($post_id, 'dry_meat_type');

    $processes = !empty($data['processes']) && is_array($data['processes'])
        ? implode(', ', $data['processes'])
        : drycured_recipe_terms_join_v4($post_id, 'dry_process_type');

    $quick = $public['quick_facts'] ?? [];

    $meat_rows = $public['meat_composition'] ?? ($data['meat_composition'] ?? []);
    $ingredients = $public['ingredients'] ?? ($data['ingredients'] ?? []);
    $steps = $public['preparation'] ?? [];

    if (empty($steps) && !empty($data['procedure_steps'])) {
        foreach ($data['procedure_steps'] as $i => $step) {
            $steps[] = [
                'title' => 'Korak ' . ($i + 1),
                'text'  => $step,
            ];
        }
    }

    $mistakes = $public['mistakes'] ?? ($data['problems'] ?? []);

    $calculator_ready = (bool)get_post_meta($post_id, '_dry_calculator_ready', true);
    $calculator_url = home_url('/kalkulator/?recipe_id=' . rawurlencode((string)get_post_meta($post_id, '_dry_recipe_id', true)));

    ob_start();
    ?>
    <article class="dry-recipe-page">

        <section class="dry-recipe-hero">
            <div class="dry-recipe-label">Recept</div>
            <h1><?php echo esc_html($title); ?></h1>

            <?php if ($intro): ?>
                <p class="dry-recipe-intro"><?php echo esc_html($intro); ?></p>
            <?php endif; ?>

            <div class="dry-recipe-tags">
                <?php echo drycured_recipe_tag_v4($region); ?>
                <?php echo drycured_recipe_tag_v4($microregion); ?>
                <?php echo drycured_recipe_tag_v4($category); ?>
                <?php echo drycured_recipe_tag_v4($product_type); ?>
                <?php echo drycured_recipe_tag_v4($meat_types); ?>
                <?php echo drycured_recipe_tag_v4($processes); ?>
            </div>

            <div class="dry-recipe-actions">
                <?php if ($calculator_ready): ?>
                    <a class="dry-primary-btn" href="<?php echo esc_url($calculator_url); ?>">Izračunaj količine</a>
                <?php endif; ?>
                <button class="dry-secondary-btn" onclick="window.print(); return false;">Ispiši recept</button>
            </div>
        </section>

        <section class="dry-quick-facts">
            <?php
            if (!empty($quick) && is_array($quick)) {
                foreach ($quick as $label => $value) {
                    echo drycured_quick_fact_v4($label, $value);
                }
            } else {
                echo drycured_quick_fact_v4('Osnovna šarža', !empty($data['batch_weight_kg']) ? $data['batch_weight_kg'] . ' kg' : 'prema receptu');
                echo drycured_quick_fact_v4('Regija', $region ?: 'nije određeno');
                echo drycured_quick_fact_v4('Vrsta', $category ?: 'nije određeno');
                echo drycured_quick_fact_v4('Meso', $meat_types ?: 'nije određeno');
                echo drycured_quick_fact_v4('Postupak', $processes ?: 'nije određeno');
                echo drycured_quick_fact_v4('Kalkulator', $calculator_ready ? 'dostupan' : 'u pripremi');
            }
            ?>
        </section>

        <?php if (!empty($data['protected_product_warning'])): ?>
            <section class="dry-protected-note">
                Ovaj zapis je edukativni profil. Ne predstavlja službenu specifikaciju za certificiranu proizvodnju zaštićenog proizvoda.
            </section>
        <?php endif; ?>

        <section class="dry-recipe-main-grid">

            <aside class="dry-ingredients-column">

                <?php if (!empty($meat_rows)): ?>
                    <div class="dry-panel">
                        <div class="dry-panel-heading">
                            <span>01</span>
                            <h2>Mesni sastav</h2>
                        </div>
                        <?php echo drycured_render_amount_list_v4($meat_rows, 'meat'); ?>
                    </div>
                <?php endif; ?>

                <?php if (!empty($ingredients)): ?>
                    <div class="dry-panel">
                        <div class="dry-panel-heading">
                            <span>02</span>
                            <h2>Sastojci i začini</h2>
                        </div>
                        <?php echo drycured_render_amount_list_v4($ingredients, 'ingredient'); ?>
                    </div>
                <?php endif; ?>

            </aside>

            <main class="dry-method-column">

                <?php if (!empty($steps)): ?>
                    <div class="dry-panel">
                        <div class="dry-panel-heading">
                            <span>03</span>
                            <h2>Priprema</h2>
                        </div>

                        <div class="dry-method-steps">
                            <?php foreach ($steps as $index => $step): ?>
                                <article class="dry-method-step">
                                    <div class="dry-step-number"><?php echo esc_html($index + 1); ?></div>
                                    <div>
                                        <h3><?php echo esc_html($step['title'] ?? ('Korak ' . ($index + 1))); ?></h3>
                                        <p><?php echo esc_html($step['text'] ?? ''); ?></p>
                                    </div>
                                </article>
                            <?php endforeach; ?>
                        </div>
                    </div>
                <?php endif; ?>

                <?php if (!empty($mistakes)): ?>
                    <div class="dry-panel">
                        <div class="dry-panel-heading">
                            <span>04</span>
                            <h2>Greške i rješenja</h2>
                        </div>

                        <div class="dry-mistake-list">
                            <?php foreach ($mistakes as $mistake): ?>
                                <article class="dry-mistake-card">
                                    <h3><?php echo esc_html($mistake['problem'] ?? 'Problem'); ?></h3>

                                    <?php
                                    $cause = $mistake['cause'] ?? ($mistake['uzrok'] ?? '');
                                    $solution = $mistake['solution'] ?? ($mistake['rjesenje'] ?? '');
                                    ?>

                                    <?php if ($cause): ?>
                                        <p><strong>Uzrok:</strong> <?php echo esc_html($cause); ?></p>
                                    <?php endif; ?>

                                    <?php if ($solution): ?>
                                        <p><strong>Rješenje:</strong> <?php echo esc_html($solution); ?></p>
                                    <?php endif; ?>
                                </article>
                            <?php endforeach; ?>
                        </div>
                    </div>
                <?php endif; ?>

            </main>
        </section>

    </article>
    <?php
    return ob_get_clean();
}

function drycured_recipe_term_name_v4($post_id, $taxonomy) {
    $terms = get_the_terms($post_id, $taxonomy);
    if (!$terms || is_wp_error($terms)) return '';
    return $terms[0]->name;
}

function drycured_recipe_terms_join_v4($post_id, $taxonomy) {
    $terms = get_the_terms($post_id, $taxonomy);
    if (!$terms || is_wp_error($terms)) return '';
    return implode(', ', wp_list_pluck($terms, 'name'));
}

function drycured_recipe_tag_v4($value) {
    if (!$value) return '';
    return '<span>' . esc_html($value) . '</span>';
}

function drycured_quick_fact_v4($label, $value) {
    if (!$value) return '';
    return '<article><span>' . esc_html($label) . '</span><strong>' . esc_html($value) . '</strong></article>';
}

function drycured_render_amount_list_v4($rows, $type = 'ingredient') {
    if (!is_array($rows) || empty($rows)) return '';

    $html = '<div class="dry-amount-list">';

    foreach ($rows as $row) {
        if (!is_array($row)) continue;

        $name = $row['name'] ?? $row['sastojak'] ?? $row['dio_mesa'] ?? $row['dio'] ?? 'Stavka';
        $amount = drycured_format_amount_v4($row);
        $note = $row['why'] ?? $row['role'] ?? $row['uloga'] ?? $row['note'] ?? $row['napomena'] ?? '';

        $html .= '<article class="dry-amount-row">';
        $html .= '<div class="dry-amount-text">';
        $html .= '<strong>' . esc_html($name) . '</strong>';
        if ($note) {
            $html .= '<p>' . esc_html($note) . '</p>';
        }
        $html .= '</div>';

        if ($amount) {
            $html .= '<div class="dry-amount-value">' . esc_html($amount) . '</div>';
        }

        $html .= '</article>';
    }

    $html .= '</div>';

    return $html;
}

function drycured_format_amount_v4($row) {
    if (!empty($row['amount'])) return $row['amount'];
    if (!empty($row['amount_note'])) return $row['amount_note'];

    if (isset($row['amount_kg'])) return drycured_number_v4($row['amount_kg']) . ' kg';
    if (isset($row['amount_g'])) return drycured_number_v4($row['amount_g']) . ' g';
    if (isset($row['amount_l'])) return drycured_number_v4($row['amount_l']) . ' L';

    if (isset($row['amount_kg_min']) && isset($row['amount_kg_max'])) {
        return drycured_number_v4($row['amount_kg_min']) . '–' . drycured_number_v4($row['amount_kg_max']) . ' kg';
    }

    if (isset($row['amount_g_min']) && isset($row['amount_g_max'])) {
        return drycured_number_v4($row['amount_g_min']) . '–' . drycured_number_v4($row['amount_g_max']) . ' g';
    }

    if (isset($row['amount_l_min']) && isset($row['amount_l_max'])) {
        return drycured_number_v4($row['amount_l_min']) . '–' . drycured_number_v4($row['amount_l_max']) . ' L';
    }

    if (isset($row['amount_pieces'])) return drycured_number_v4($row['amount_pieces']) . ' kom';

    if (!empty($row['kolicina'])) return $row['kolicina'];
    if (!empty($row['kolicina_za_10_kg'])) return $row['kolicina_za_10_kg'];

    return '';
}

function drycured_number_v4($value) {
    if (!is_numeric($value)) return $value;

    $value = floatval($value);

    if (floor($value) == $value) return (string)intval($value);

    return rtrim(rtrim(number_format($value, 3, ',', ''), '0'), ',');
}
