server {
    if ($host = www.drycured.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = drycured.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name drycured.com www.drycured.com;
    return 301 https://drycured.com$request_uri;




}

server {
    listen 443 ssl;
    server_name drycured.com www.drycured.com;
    root /var/www/html;

    # DRYCURED plugins backup/source public access block v0.0.1
    # Prevent public access to stale plugin backup/source files.
    location ~* ^/wp-content/plugins/.*\.bak.*$ {
        deny all;
        return 403;
    }

    location ~* ^/wp-content/plugins/.*\.(old|orig|save)(-|$|\.|_) {
        deny all;
        return 403;
    }



    # DRYCURED mu-plugins backup/source public access block v0.0.2
    # Prevent public access to stale MU-plugin backup/source files.
    location ~* ^/wp-content/mu-plugins/.*\.bak.*$ {
        deny all;
        return 403;
    }

    location ~* ^/wp-content/mu-plugins/.*\.(old|orig|save)(-|$|\.|_) {
        deny all;
        return 403;
    }




    # DRYCURED backup plugin public access block v0.0.1
    # Prevent public access to legacy backup plugin directories.
    location ^~ /wp-content/ai1wm-backups/ {
        deny all;
        return 403;
    }

    location ^~ /wp-content/backups-dup-lite/ {
        deny all;
        return 403;
    }



    # DRYCURED login rate limit v0.0.1
    # Conservative protection for wp-login.php only.
    location = /wp-login.php {
        limit_req zone=drycured_login burst=10 nodelay;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }



    # DRYCURED XML-RPC block v0.0.1
    # XML-RPC is not required for current drycured.com workflows.
    # REST API remains available.
    location = /xmlrpc.php {
        access_log off;
        log_not_found off;
        return 403;
    }

    location = //xmlrpc.php {
        access_log off;
        log_not_found off;
        return 403;
    }


    include /etc/nginx/snippets/drycured-security-headers-basic.conf;
    include /etc/nginx/snippets/drycured-csp-report-only.conf;


    # DRYCURED public exposure block v0.0.2
    # Blocks public access to backup/archive/staging files.
    location ^~ /projekti/ {
        deny all;
        return 403;
    }

    location ^~ /swabtest/ {
        deny all;
        return 403;
    }

    location ^~ /wp-content/uploads/drycured/backups/ {
        deny all;
        return 403;
    }

    location ^~ /wp-content/uploads/drycured/infografike-greske-staging/ {
        deny all;
        return 403;
    }

    location ~* ^/wp-content/(plugins|themes|mu-plugins)/.*\.(bak|old|orig|save|sql|sql\.gz|tar|tar\.gz|tgz|zip|7z|rar)$ {
        deny all;
        return 403;
    }

    location ~* \.(sql|sql\.gz|tar|tar\.gz|tgz|7z|rar|bak|old|orig|save)$ {
        deny all;
        return 403;
    }


    client_max_body_size 256M;
    index index.php index.html;

    include /etc/nginx/snippets/drycured-gzip-types.conf;
    include /etc/nginx/snippets/drycured-static-cache.conf;
    ssl_certificate /etc/letsencrypt/live/drycured.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/drycured.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
    }


}